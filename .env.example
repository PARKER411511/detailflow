
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Current Supabase browser-safe key. Existing projects may use the legacy anon key below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only key for provisioning or explicitly configured verification scripts.
# Never expose this key to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
