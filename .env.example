NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the current publishable key for new projects. The app also accepts the
# legacy anon key below for existing projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional server-only key for provisioning/integration scripts. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
